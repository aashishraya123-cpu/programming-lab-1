import tkinter as tk
from tkinter import ttk

from week8tuesday import *
def onBook():
    name = name_box.get()
    tickets = int(tickets_box.get())
    movie = movie_box.get()
    booking = book_seat(name,movie,tickets)
    message = "Ticket" + str(booking["Ticket Number"]) + " booked for " + booking["Name"] + " for movie " + booking["Movie"] + " with total price $" + str(booking["Total Price"])
    result_label.config(text=message)

    refresh_list()

def onPay():
    ticket_number = int(ticket_box.get())
    if pay_ticket(ticket_number):
        message = "Ticket " + str(ticket_number) + " paid successfully!"
    else:
        message = "Ticket " + str(ticket_number) + " not found!"
    result_label.config(text=message)

    refresh_list()

def refresh_list():
    bookings_list.delete(0, tk.END)
    for booking in bookings:
        row = "Ticket " + str(booking["Ticket Number"]) + ": " + booking["Name"] + " - " + booking["Movie"] + " - $" + str(booking["Total Price"]) + " - " + booking["Status"]
        bookings_list.insert(tk.END, row)

window = tk.Tk()
window.title("Cinema Ticket Booking")

tk.Label(window, text="Enter your name:").grid(row=0, column=0, padx=10, pady=5)
name_box = tk.Entry(window)
name_box.grid(row=0, column=1, padx=10, pady=5)

tk.Label(window, text="Select a movie:").grid(row=1, column=0, padx=10, pady=5)
movie_box = ttk.Combobox(window, values = list(movie))    
movie_box.grid(row=1, column=1, padx=10, pady=5) 
movie_box.current(0)  # Set default selection to the first movie

tk.Label(window, text="Number of tickets:").grid(row=2, column=0, padx=10, pady=5)
tickets_box = tk.Entry(window)
tickets_box.grid(row=2, column=1, padx=10, pady=5)

tk.Button(window, text="Book Ticket", command=onBook).grid(row=3, column=0, columnspan=2, pady=10)
result_label = tk.Label(window, text="")
result_label.grid(row=4, column=0, columnspan=2, pady=5)

tk.Label(window, text="Enter ticket number to pay:").grid(row=5, column=0, padx=10, pady=5)
ticket_box = tk.Entry(window)
ticket_box.grid(row=5, column=1, padx=10, pady=5)

tk.Button(window, text="Pay Ticket", command=onPay).grid(row=6, column=0, columnspan=2, pady=10)
tk.Label(window, text="Bookings:").grid(row=7, column=0, padx=10, pady=5)
bookings_list = tk.Listbox(window, width=50, height=10)
bookings_list.grid(row=8, column=0, columnspan=2, padx=10, pady=5)


window.mainloop()