def add_items():
    items = []
    prices = []

    item_name = input("Enter item name (type 'done' to finish): ")

    while item_name.lower() != "done":
        item_price = float(input("Enter item price: "))

        items.append(item_name)
        prices.append(item_price)

        item_name = input("Enter item name (type 'done' to finish): ")

    return items, prices

def calculate_total(prices):
    total = 0

    for price in prices:
        total += price

    return total

def display(items, prices, total):
    print("\n--- Shopping List ---")

    for index in range(len(items)):
        print(items[index], "- $", prices[index])

    print("---------------------")
    print("Total: $", total)

items, prices = add_items()
total = calculate_total(prices)
display(items, prices, total)